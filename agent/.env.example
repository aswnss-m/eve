# Copy to .env. Get EVE_SHARED_SECRET from Eve Agent Settings -> "Agent Server Env".
EVE_SHARED_SECRET=
# Where the agent server reaches Frappe (server to server).
FRAPPE_URL=http://127.0.0.1:8000
PORT=8787
# Optional: reach FalkorDB at a different URL than the one in Eve Agent Settings (e.g. in Docker).
FALKORDB_URL=
# Optional provider keys, used when Eve Agent Settings has no LLM API Key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
